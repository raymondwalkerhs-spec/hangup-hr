# Hangup HR — Supabase (required)
DATA_BACKEND=supabase
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_PUBLISHABLE_KEY=your_sb_publishable_key
SUPABASE_SECRET_KEY=your_sb_secret_key
SUPABASE_JWKS_URL=https://your-project.supabase.co/auth/v1/.well-known/jwks.json
# SUPABASE_ACCESS_TOKEN=your_personal_access_token
# SUPABASE_DB_PASSWORD=your_database_password

TRANSPORT_ELIGIBLE_FROM_MONTH=2026-07
# Required — use a long random string in production (build fails when HR_RELEASE_BUILD=1 if default)
SESSION_SECRET=change-this-to-a-long-random-string
PORT=3847

# Packaged installs: copy .env to %APPDATA%/Hangup Portal/HangupHR-data/.env
# Service account keys: userData/credentials/ or absolute path in INTERVIEWS_KEY

# GitHub in-app updates (desktop)
GITHUB_UPDATES_REPO=owner/repo
# GITHUB_UPDATES_TOKEN=ghp_... (required for private repos)

# Page QA (npm run test:pages / push:update)
# HR_TEST_USER=admin_or_ceo_username
# HR_TEST_PASSWORD=

# Dropbox (sales attachments)
# DROPBOX_ACCESS_TOKEN=
# DROPBOX_APP_KEY=
# DROPBOX_APP_SECRET=

# Airtable (outbound sync — optional)
# MLA (existing base)
# AIRTABLE_API_KEY=pat...
# AIRTABLE_BASE_ID=app...   # must be a base your token can access
# AIRTABLE_TABLE_NAME=MLA     # e.g. MLA in Internal Main 2026 (not always "Sales All Data")
# AIRTABLE_SYNC_ENABLED=true
# AIRTABLE_SYNC_DEBOUNCE_MS=0
# AIRTABLE_ATTACHMENT_URL_TTL_SEC=7200
# AIRTABLE_SKIP_ATTACHMENT_KINDS=   # empty = sync all attachment columns present on the table
# AIRTABLE_PORTAL_SALE_ID_FIELD=Portal Sale ID   # set to empty to disable upsert lookup
#
# RPM + Q Feedback (separate Hangup RPM base — do not reuse AIRTABLE_BASE_ID)
# AIRTABLE_RPM_TOKEN=pat...          # PAT with access to the RPM base (recommended)
# AIRTABLE_RPM_WORKSPACE_ID=wspElJw1rTpyIogEE
# AIRTABLE_RPM_BASE_ID=app...
# AIRTABLE_RPM_SALES_TABLE_NAME=RPM Sales
# AIRTABLE_RPM_QFEEDBACK_TABLE_NAME=Q Feedback
# AIRTABLE_RPM_NQ_TABLE_NAME=NQ Checks
# AIRTABLE_RPM_SYNC_ENABLED=true
# Live sync is Supabase → Airtable (Edge Function). Do not set AIRTABLE_RPM_SYNC_FROM_APP.
# npm run deploy:airtable:rpm-sync
# npm run provision:airtable:rpm
# npm run sync:airtable:rpm
#
# RPM1 → Google Forms (Supabase Edge Function only — desktop app does not POST)
# Defaults submit BOTH: TEST Tracking + Direct Tracking. Override with:
# GOOGLE_FORM_TARGETS_JSON=[{"id":"test","url":".../formResponse","entries":{...}},{"id":"direct","url":"...","entries":{...}}]
# npm run deploy:rpm-google-form
# Ops one-shot (invokes Supabase Edge Function — does not POST Google from the PC):
# npm run submit:rpm1-google-form-today

# Google Sheets / Drive is deprecated — see LEGACY_GOOGLE_SHEETS.md (do not use in production)

# Interview sheet (Google Sheets service account)
INTERVIEW_SHEET=your_sheet_id
SERVICE_EMAIL=your_service_account_email
INTERVIEWS_KEY=Asset/INTERVIEWS_KEY.json
# INTERVIEW_TAB=Form Responses 1
