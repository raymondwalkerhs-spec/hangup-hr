{
  "name": "hangup-hr",
  "version": "2.5.0",
  "description": "Hangup Portal desktop app ÃƒÆ’Ã‚Â¢ÃƒÂ¢Ã¢â‚¬Å¡Ã‚Â¬ÃƒÂ¢Ã¢â€šÂ¬Ã‚Â Supabase backend",
  "main": "electron/main.js",
  "scripts": {
    "start": "node scripts/ensure-electron.js && electron .",
    "dev": "node scripts/ensure-electron.js && electron .",
    "pack": "electron-builder --dir",
    "dist": "powershell -ExecutionPolicy Bypass -File scripts/build.ps1 all",
    "dist:installer": "powershell -ExecutionPolicy Bypass -File scripts/build.ps1 installer",
    "dist:portable": "powershell -ExecutionPolicy Bypass -File scripts/build.ps1 portable",
    "dist:all": "powershell -ExecutionPolicy Bypass -File scripts/build.ps1 all",
    "dist:mac": "node scripts/ensure-macos.js && electron-builder --mac dmg zip",
    "dist:mac:script": "bash scripts/build-macos.sh",
    "dist:mac:dmg": "node scripts/ensure-macos.js && electron-builder --mac dmg",
    "package:github": "node scripts/package-github-release.js",
    "verify:update": "node scripts/verify-update-package.js",
    "publish:github": "powershell -ExecutionPolicy Bypass -File scripts/publish-github-release.ps1",
    "publish:installer": "powershell -ExecutionPolicy Bypass -File scripts/publish-installer-only.ps1",
    "dist:bootstrap": "powershell -ExecutionPolicy Bypass -File scripts/build-web-installer.ps1",
    "dist:web-installer": "powershell -ExecutionPolicy Bypass -File scripts/build-web-installer.ps1",
    "bootstrap:github": "powershell -ExecutionPolicy Bypass -File scripts/bootstrap-github-repo.ps1",
    "push:sheet": "node scripts/push-excel-to-sheet.js",
    "import:excel": "python ../scripts/import_data.py && node scripts/push-excel-to-sheet.js",
    "reconcile:june": "node scripts/reconcile-june.js",
    "migrate:archived": "echo Archived ÃƒÆ’Ã‚Â¢ÃƒÂ¢Ã¢â‚¬Å¡Ã‚Â¬ÃƒÂ¢Ã¢â€šÂ¬Ã‚Â Excel source removed. Use push:sheet with existing hr-system/data JSON only.",
    "rebuild:native": "npx @electron/rebuild -f -w better-sqlite3,bcrypt",
    "verify:native": "node scripts/verify-native-modules.js",
    "postinstall": "node scripts/postinstall-native.js",
    "fix:electron": "node node_modules/electron/install.js",
    "test:supabase": "node scripts/test-supabase.js",
    "test:training-payroll": "node scripts/test-training-payroll.js",
    "qa:training-payroll": "node scripts/qa-training-payroll-check.js",
    "cleanup:artifacts": "node scripts/cleanup-github-artifacts.js",
    "migrate:supabase": "node scripts/migrate-sheets-to-supabase.js",
    "migrate:sale-attachments": "node scripts/migrate-sale-attachments-to-supabase.js",
    "apply:github-patch": "node scripts/apply-github-patch-standalone.js",
    "seed:fp-june": "node scripts/seed-june-fp-mappings.js",
    "apply:migrations": "node scripts/apply-pending-migrations.js",
    "sync:airtable": "node scripts/backfill-airtable-sales.js",
    "provision:airtable": "node scripts/provision-airtable-sales-fields.js",
    "sync:airtable:rpm": "node scripts/backfill-airtable-rpm.js",
    "provision:airtable:rpm": "node scripts/provision-airtable-rpm.js",
    "deploy:airtable:rpm-sync": "node scripts/deploy-airtable-rpm-sync.js",
    "deploy:rpm-google-form": "node scripts/deploy-rpm-google-form-sync.js",
    "submit:rpm1-google-form-today": "node scripts/submit-rpm1-google-form-today.js",
    "audit:airtable:rpm": "node scripts/audit-airtable-rpm-sync.js",
    "backfill:confirmations": "node scripts/backfill-confirmation-from-csv.js --csv=\"Asset/cancel MLA-Source.csv\"",
    "test": "node scripts/run-all-tests.js",
    "test:security": "node scripts/test-security.js",
    "import:cash": "node scripts/sync-cash-xlsx.js",
    "sync:cash": "node scripts/sync-cash-xlsx.js",
    "backfill:expense-categories": "node scripts/backfill-expense-categories.js",
    "disable:departed-logins": "node scripts/disable-departed-logins.js",
    "test:access-scope": "node scripts/test-access-scope.js",
    "test:quality-sales-perms": "node scripts/test-quality-sales-perms.js",
    "test:rbac-defaults": "node scripts/test-rbac-defaults.js",
    "test:equipment-clearance": "node scripts/test-equipment-clearance.js",
    "test:rbac-company": "node scripts/test-rbac-company-scope.js",
    "test:company-scenarios": "node scripts/test-company-isolation-scenarios.js",
    "backup": "node scripts/ensure-electron.js && electron electron/backup-main.js",
    "start:backup": "node scripts/ensure-electron.js && electron electron/backup-main.js",
    "dev:web": "vite",
    "build:web": "vite build",
    "preview:web": "vite preview",
    "test:pages": "node scripts/test-app-pages.js",
    "test:rpm-forms": "node scripts/test-rpm-checks-forms.js",
    "push:update": "node scripts/push-update.js"
  },
  "overrides": {
    "defer-to-connect": "2.0.1"
  },
  "build": {
    "appId": "com.hangup.hr",
    "productName": "Hangup Portal",
    "directories": {
      "output": "dist"
    },
    "files": [
      "electron/**/*",
      "lib/**/*",
      "routes/**/*",
      "scripts/**/*",
      "public/**/*",
      "public/dist/**/*",
      "Asset/**/*",
      "app.js",
      "backup-app.js",
      "package.json",
      "node_modules/adm-zip/**/*"
    ],
    "asarUnpack": [
      "node_modules/better-sqlite3/**/*"
    ],
    "extraResources": [
      {
        "from": ".env.example",
        "to": ".env.example"
      }
    ],
    "win": {
      "icon": "build/icon.png",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "Hangup-Portal-Setup-${version}.${ext}"
    },
    "npmRebuild": true,
    "forceCodeSigning": false,
    "afterPack": "scripts/electron-after-pack.js",
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Hangup Portal",
      "uninstallDisplayName": "Hangup Portal"
    },
    "portable": {
      "artifactName": "Hangup-Portal-Portable-${version}.${ext}"
    },
    "mac": {
      "icon": "build/icon.png",
      "category": "public.app-category.business",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "x64",
            "arm64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ],
      "artifactName": "Hangup-Portal-${version}-${arch}.${ext}",
      "identity": null,
      "hardenedRuntime": false,
      "gatekeeperAssess": false
    },
    "dmg": {
      "title": "Hangup Portal ${version}",
      "artifactName": "Hangup-Portal-${version}-${arch}.${ext}"
    }
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@radix-ui/react-dialog": "^1.1.6",
    "@radix-ui/react-dropdown-menu": "^2.1.6",
    "@radix-ui/react-hover-card": "^1.1.6",
    "@radix-ui/react-select": "^2.1.6",
    "@radix-ui/react-slot": "^1.1.2",
    "@radix-ui/react-switch": "^1.1.3",
    "@radix-ui/react-tabs": "^1.1.3",
    "@radix-ui/react-tooltip": "^1.1.8",
    "@supabase/supabase-js": "^2.110.0",
    "@tanstack/react-query": "^5.66.9",
    "@tanstack/react-table": "^8.21.2",
    "@tanstack/react-virtual": "^3.11.2",
    "adm-zip": "^0.5.18",
    "archiver": "^8.0.0",
    "bcrypt": "^6.0.0",
    "better-sqlite3": "^12.11.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.0.4",
    "cookie-parser": "^1.4.7",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "express-session": "^1.18.1",
    "framer-motion": "^12.4.7",
    "googleapis": "^144.0.0",
    "lucide-react": "^0.475.0",
    "pdfkit": "^0.16.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-grid-layout": "^1.5.0",
    "react-router-dom": "^7.2.0",
    "recharts": "^2.15.1",
    "sonner": "^2.0.1",
    "ws": "^8.21.0",
    "xlsx": "^0.18.5",
    "zustand": "^5.0.3"
  },
  "devDependencies": {
    "@electron/fuses": "^2.1.3",
    "@electron/rebuild": "^4.2.0",
    "@types/react": "^19.0.10",
    "@types/react-dom": "^19.0.4",
    "@types/react-grid-layout": "^1.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "electron": "^33.4.11",
    "electron-builder": "^25.1.8",
    "pg": "^8.22.0",
    "playwright": "^1.62.1",
    "typescript": "^5.7.3",
    "vite": "^6.1.0"
  }
}
